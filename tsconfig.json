{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vitest/globals"],
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src/**/*", "vitest-setup.ts", "**/*.test.ts"]
}
